local function refreshFiles()
    if not menu then return end
    local list = scanConfigs()
    for i = 1, FILE_SLOTS do
        menu.set("cfgFile" .. i, list[i])
    end
end

if menu then
    for i = 1, FILE_SLOTS do
        local rid = "cfgFile" .. i

        menu.on(rid .. ":load", function(name)
            if name and loadConfig(name) then
                CFG.cfgName = name
                setAutoName(name)
                menu.redraw()
            end
        end)

        menu.on(rid .. ":save", function(name)
            if not name then return end
            menu.confirm("overwrite '" .. name .. "'?", function()
                saveConfig(name)
                setAutoName(name)
                refreshFiles()
            end)
        end)

        menu.on(rid .. ":del", function(name)
            if not name then return end
            menu.confirm("delete '" .. name .. "'?", function()
                pcall(delfile, cfgPath(name))
                if getAutoName() == name then setAutoName("") end
                if CFG.cfgName == name then CFG.cfgName = "config1" end
                refreshFiles()
            end)
        end)
    end

    menu.on("cfgCreate", function()
        local n = tostring(CFG.cfgName or ""):gsub("[^%w_%- ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
        if #n == 0 then return end
        CFG.cfgName = n
        saveConfig(n)
        setAutoName(n)
        refreshFiles()
    end)

    refreshFiles()

    local lastMenuErr = nil
    local function safeMenu()
        local ok, e = pcall(menu.step)
        if not ok and e ~= lastMenuErr then
            lastMenuErr = e
            warn("[tb] menu: " .. tostring(e))
        end
    end

    local menuHooked = false
    pcall(function()
        local rs = game:GetService("RunService")
        if rs and rs.RenderStepped then
            rs.RenderStepped:Connect(safeMenu)
            menuHooked = true
        end
    end)
    if not menuHooked then
        spawn(function()
            while true do
                safeMenu()
                wait(0.001)
            end
        end)
    end
else
    warn("[tb] menu unavailable -- running without it")
end
