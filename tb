local MOUSE_FN = {
    [0x01] = ismouse1pressed,
    [0x02] = ismouse2pressed,
    [0x04] = ismouse3pressed,
    [0x05] = ismouse4pressed,
    [0x06] = ismouse5pressed,
}
local function vkHeld(vk)
    local fn = MOUSE_FN[vk]
    if fn then
        local ok, r = pcall(fn)
        if ok then return r == true end
    end
    -- side buttons are also plain VK codes, so ask the keyboard check too
    local ok, r = pcall(iskeypressed, vk)
    if ok and r == true then return true end
    if UIS and UIS.IsKeyDown then
        local okd, down = pcall(function() return UIS:IsKeyDown(vk) end)
        if okd then return down == true end
    end
    return false
end

local kbOn, kbPrev = false, false
local function keyActive()
    local mode = CFG.tb_kbmode
    if mode == "always" then return true end
    local held = vkHeld(CFG.tb_key)
    if mode == "toggle" then
        if held and not kbPrev then kbOn = not kbOn end
        kbPrev = held
        return kbOn
    end
    return held
end

local function windowActive()
