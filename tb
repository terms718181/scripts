-- walk the ray past glass/nc parts, give up after 8 hops
local function wallBetween(pos, targetChar)
    local lp = localPlayer()
    local lpChar = lp and lp.Character
    local cam = Workspace.CurrentCamera
    local origin = (cam and cam.Position) or localRootPos()

    for _ = 1, 8 do
        local dir = pos - origin
        if dir.Magnitude < 0.05 then return false end
        local ok, res = pcall(function()
            return Workspace:Raycast(origin, dir)
        end)
        if not ok or res == nil or res.Instance == nil then return false end
        local inst = res.Instance
        if inst:IsDescendantOf(targetChar) then return false end
        local skip = (lpChar and inst:IsDescendantOf(lpChar))
            or inst.CanCollide == false
            or (inst.Transparency or 0) > 0.9
        if not skip then return true end
        if res.Position == nil then return false end
        origin = res.Position + dir.Unit * 0.15
    end
    return false
end

local function fireGun(now)
    local hold = randRange(cfg("tb_hold_min"), cfg("tb_hold_max")) / 1000
    if hold > 0.002 and pcall(mouse1press) then
        pendingRelease = now + hold
        return
    end
    pcall(mouse1click)
end

local lastErr = nil

local function step()
    local now = tick()
    tbEngaged = false

    if pendingRelease > 0 and now >= pendingRelease then
        pcall(mouse1release)
        pendingRelease = 0
    end

    if not cfg("tb_enabled") or not windowActive() then
        resetLock()
        hideCube()
        return
    end

    local cx, cy = cursorPos()

    pruneSel()
    do
        local cam = Workspace.CurrentCamera
        local lens = lensInfo()
        if cam and lens then updateSelVis(cam, lens) end
    end

    local localPos = localRootPos()
    local closest0 = findClosest(cx, cy, localPos, true)
    local selH = CFG.tb_selkey ~= 0 and vkHeld(CFG.tb_selkey)
    local unselH = CFG.tb_unselkey ~= 0 and vkHeld(CFG.tb_unselkey)
    if selH and not prevSelKey and closest0 then
        if SELECTED[selKey(closest0)] then remSel(closest0) else addSel(closest0) end
    end
    if unselH and not prevUnselKey then
        local st = closestSelected(cx, cy)
        if st then remSel(st) end
    end
    prevSelKey, prevUnselKey = selH, unselH

    if knifeOut() then
        return
    end

    if not keyActive() then
        resetLock()
        hideCube()
        return
    end

    local target = LOCKED
    local closest, closestDist = findClosest(cx, cy, localPos)

    if not LOCKED then
        target = closest
    elseif closest and closest.character ~= LOCKED.character then
        local lhrp = rootOf(LOCKED)
        local lockedDist = 9e9
        if lhrp then
            local lsp, lon = WorldToScreen(lhrp.Position)
            if lon then
                lockedDist = dist2(lsp.X, lsp.Y, cx, cy)
            end
        end
        if closestDist + 8 < lockedDist then
            target = closest
        end
    end

    if not validTarget(target) or not selOk(target) then
        resetLock()
        hideCube()
        return
    end

    LOCKED = target
    _G.StellarTriggerbot.LockedTarget = target.character

    local hrp = rootOf(target)
    local pos = hrp.Position

    local maxd = wepCap()
    if (pos.X == 0 and pos.Y == 0 and pos.Z == 0) or pos == localPos
        or (maxd > 0 and dist3(localPos, pos) > maxd) then
        resetLock()
        hideCube()
        return
    end

    if TRACK_CHAR ~= target.character then
        TRACK_CHAR = target.character
        TRACKED_VEL = Vector3.new(0, 0, 0)
        resetEngagement()
    else
        local dt = now - TRACK_T
        if dt > 0 then
            local sm = math.min(math.max(cfg("tb_pred_smooth") or 0.4, 0), 0.95)
            local iv = (pos - TRACK_POS) / dt
            TRACKED_VEL = TRACKED_VEL + (iv - TRACKED_VEL) * (1 - sm)
        end
    end
    TRACK_POS = pos
    TRACK_T = now

    if cfg("tb_pred") then
        local vel = TRACKED_VEL

        local px, py = cfg("tb_pred_x"), cfg("tb_pred_y")

        if cfg("tb_dist_pred") then
            local d = dist3(localPos, pos)
            if d <= cfg("tb_close_dist") then
                px, py = cfg("tb_close_x"), cfg("tb_close_y")
            elseif d <= cfg("tb_mid_dist") then
                px, py = cfg("tb_mid_x"), cfg("tb_mid_y")
            else
                px, py = cfg("tb_far_x"), cfg("tb_far_y")
            end
        end

        pos = pos + vel * Vector3.new(px, py, px)
    end

    _G.StellarTriggerbot.TargetPosition = pos

    local sp, onScreen = WorldToScreen(pos)
    if not onScreen then
        resetEngagement()
        hideCube()
        return
    end

    local hx, hy = cfg("tb_hitbox_x"), cfg("tb_hitbox_y")
    local inside = false

    if cfg("tb_visualize") then
        local size = Vector3.new(hx, hy, hx)
        local corners = getCorners(pos, size)

        local verts2d = {}
        local pts = {}
        local allOnScreen = true
        for i = 1, 8 do
            local cp, os2 = WorldToScreen(corners[i])
            verts2d[i] = cp
            if os2 then
                pts[#pts + 1] = cp
            else
                allOnScreen = false
            end
        end

        if allOnScreen then
            drawCube(verts2d)
        else
            hideCube()
        end

        if #pts >= 3 then
            local hull = convexHull(pts)
            inside = pointInPolygon(hull, cx, cy)
                or nearPolygonEdge(hull, cx, cy, 12)
        end
    else
        hideCube()

        local cursorD = dist2(sp.X, sp.Y, cx, cy)
        local test = true
        local lens = lensInfo()
        if lens then
            local dist = dist3(Workspace.CurrentCamera.Position, pos)
            local pxPerStud = (lens.vp.Y * 0.5)
                / math.tan(math.rad(lens.fov) * 0.5)
                / math.max(dist, 0.05)
            test = cursorD
                <= math.sqrt(hx * hx + hy * hy + hx * hx) * pxPerStud + 16
        end

        if test then
            local spx = WorldToScreen(pos + Vector3.new(hx, 0, 0))
            local spz = WorldToScreen(pos + Vector3.new(0, 0, hx))
            local spy = WorldToScreen(pos + Vector3.new(0, hy, 0))
            local hw = math.max(math.abs(spx.X - sp.X), math.abs(spz.X - sp.X))
            local hh = math.abs(spy.Y - sp.Y)
            inside = math.abs(cx - sp.X) <= hw + 12
                and math.abs(cy - sp.Y) <= hh + 12
        end
    end

    if inside then
        stickyUntil = now + 0.12
    elseif now < stickyUntil then
        inside = true
    end

    if inside then
        tbEngaged = true
        local fire = true
        local humOn = cfg("tb_humanize")

        if now >= wallCheckAt then
            wallCheckAt = now + 0.05
            wallBlocked = wallBetween(pos, target.character)
        end
        if wallBlocked then
            fire = false
        end

        if fire and humOn then
            if not insideSince then
                insideSince = now
                shotCount = 0
                entryDelay = randRange(cfg("tb_delay_min"), cfg("tb_delay_max")) / 1000
            end
            if now - insideSince < entryDelay
                or now - lastClick < nextClickIn
                or now < pauseUntil
            then
                fire = false
            end
        end

        if fire then
            if humOn then
                fireGun(now)
                shotCount = shotCount + 1
                nextClickIn = (randRange(cfg("tb_int_min"), cfg("tb_int_max"))
                    + math.min(shotCount, 20) * (tonumber(cfg("tb_fatigue")) or 0)) / 1000
                if math.random() * 100 < (tonumber(cfg("tb_hes_chance")) or 0) then
                    pauseUntil = now + randRange(cfg("tb_hes_min"), cfg("tb_hes_max")) / 1000
                end
            else
                pcall(mouse1click)
            end
            lastClick = now
            lastFireAt = now
        end
    else
        resetEngagement()
    end
end

-- =====================================================================
-- gun macro: cycles the ticked guns so the draw animation is skipped and
-- the fire cooldown resets, which reads as a much faster shot rate
-- =====================================================================
local GM_GUNS = {
    { cfgid = "gm_rev", slotid = "gm_rev_slot", test = function(low)
        return low:find("revolver", 1, true) ~= nil
    end },
    { cfgid = "gm_db", slotid = "gm_db_slot", test = function(low)
        return low:find("double", 1, true) ~= nil and low:find("barrel", 1, true) ~= nil
    end },
    { cfgid = "gm_tac", slotid = "gm_tac_slot", test = function(low)
        return low == "tac"
            or (low:find("tac", 1, true) ~= nil and low:find("shotgun", 1, true) ~= nil)
    end },
}

local gmPrev, gmOn = false, false
local gmNext, gmErr = 0, nil
local gmHeldVk, gmIdx, gmCheckAt = nil, 0, 0
local gmPin = nil

local function gmActive()
    if not cfg("gm_on") then return false end
    if cfg("gm_link") then
        -- linked: only while the trigger has a target under the crosshair.
        -- a linger above 0 keeps the spam alive briefly after it disengages.
        if tbEngaged then return true end
        local linger = (tonumber(cfg("gm_link_ms")) or 0) / 1000
        return linger > 0 and (tick() - lastFireAt) <= linger
    end
    local mode = cfg("gm_mode")
    if mode == "always" then return true end
    local key = cfg("gm_key")
    local pressed = key ~= nil and vkHeld(key)
    if mode == "toggle" then
        if pressed and not gmPrev then gmOn = not gmOn end
        gmPrev = pressed
        return gmOn
    end
    return pressed
end

-- which guns are ticked, resolved once per pass. the old version asked cfg()
-- for every gun for every child of every box, which ran to dozens of snapshot
-- lookups per swap; the ticked set does not change inside one swap
local function gmEnabled()
    local out = {}
    for _, g in ipairs(GM_GUNS) do
        if cfg(g.cfgid) then out[#out + 1] = g end
    end
    return out
end

local function gmWanted(name, guns)
    local low = tostring(name or ""):lower()
    for _, g in ipairs(guns) do
        if g.test(low) then return true end
    end
    return false
end

-- one walk per swap, shared by every gun, instead of one walk per gun
local function gmCollect(box, out, guns)
    if not box then return end
    pcall(function()
        for _, d in ipairs(box:GetChildren()) do
            -- IsA lies on this executor, compare ClassName directly
            if d.ClassName == "Tool" and gmWanted(d.Name, guns) then
                out[#out + 1] = d
            end
        end
    end)
end

-- backpack plus equipped, so a gun counts wherever it sits
local function gmPool()
    local lp = localPlayer()
    local char = lp and lp.Character
    if not char then return {}, nil end
    local guns = gmEnabled()
    local out = {}
    if #guns > 0 then
        gmCollect(char, out, guns)
        local ok, pack = pcall(function() return lp:FindFirstChildOfClass("Backpack") end)
        if ok then gmCollect(pack, out, guns) end
    end
    local hum
    pcall(function() hum = char:FindFirstChildOfClass("Humanoid") end)
    return out, hum
end

-- ammo: a gun reading as empty drops out of the cycle so the guns with
-- ammo keep swapping. a gun with no readable ammo stays in, so an unknown
-- source never blocks anything.
local GM_AMMO_ATTRS = { "Ammo", "ammo", "AmmoCount", "AmmoLeft", "AmmoValue", "Clip", "ClipAmmo", "CurrentAmmo", "Mag", "Magazine", "Bullets", "Shots" }
local GM_AMMO_KIDS = { ammo = true, ammocount = true, ammoleft = true, clip = true, clipammo = true, currentammo = true, mag = true, magazine = true, bullets = true, shots = true }
local gmAmmoCache = {}

local function gmNum(v)
    if type(v) == "number" then return v end
    if type(v) == "string" then
        local n = v:match("%d+")
        if n then return tonumber(n) end
    end
    return nil
end

-- the source that answered last time is remembered per tool, so a repeat ask
-- is one property read instead of a GetDescendants walk over the whole tool.
-- a tool with nothing readable is parked for 2s, so the walking path costs at
-- most one walk per tool per 2s instead of one per cache tick
local gmAmmoRef = setmetatable({}, { __mode = "k" })

local function gmReadAmmo(tool, now)
    local ref = gmAmmoRef[tool]
    if ref then
        if ref.none then
            if now - ref.none < 2 then return nil end
        else
            local ok, raw
            if ref.attr then
                ok, raw = pcall(function() return tool:GetAttribute(ref.attr) end)
            else
                ok, raw = pcall(function() return ref.obj.Value end)
            end
            local n = ok and gmNum(raw) or nil
            if n then return n end
        end
        gmAmmoRef[tool] = nil
    end
    for _, a in ipairs(GM_AMMO_ATTRS) do
        local ok, raw = pcall(function() return tool:GetAttribute(a) end)
        local n = ok and gmNum(raw) or nil
        if n then
            gmAmmoRef[tool] = { attr = a }
            return n
        end
    end
    local ok2, n2, obj = pcall(function()
        for _, d in ipairs(tool:GetDescendants()) do
            if GM_AMMO_KIDS[tostring(d.Name):lower()]
                and tostring(d.ClassName):find("Value", 1, true) then
                local num = gmNum(d.Value)
                if num then return num, d end
            end
        end
        return nil
    end)
    if ok2 and n2 ~= nil then
        gmAmmoRef[tool] = obj and { obj = obj } or nil
        return n2
    end
    gmAmmoRef[tool] = { none = now }
    return nil
end

-- cached briefly, the cycle asks once per swap
local function gmToolAmmo(tool)
    local key = tostring(tool.Name)
    local now = tick()
    local hit = gmAmmoCache[key]
    if hit and now - hit.t < 0.2 then return hit.n end
    local n = gmReadAmmo(tool, now)
    gmAmmoCache[key] = { t = now, n = n }
    return n
end

local function gmToolEmpty(tool)
    if not cfg("gm_ammo") then return false end
    local n = gmToolAmmo(tool)
    return n ~= nil and n <= 0
end

-- the gun's own tool, wherever it sits. the pool comes in as an argument:
-- a fresh scan per gun per swap was the most expensive thing in this loop
local function gmGunEmpty(g, pool, ammoOn)
    if not ammoOn then return false end
    for _, t in ipairs(pool) do
        if g.test(tostring(t.Name):lower()) then return gmToolEmpty(t) end
    end
    return false
end

-- slots are the hotbar number keys the guns sit on. each entry keeps its gun
-- so the hand can be compared against that exact gun, not just "some ticked gun"
local function gmSlots(pool, ammoOn)
    local out = {}
    for _, g in ipairs(GM_GUNS) do
        if cfg(g.cfgid) then
            local slot = tonumber(cfg(g.slotid))
            if slot and slot >= 1 and slot <= 9 and not gmGunEmpty(g, pool, ammoOn) then
                out[#out + 1] = { slot = slot, gun = g }
            end
        end
    end
    return out
end

-- let go of whatever key the last swap pressed
local function gmRelease()
    if gmHeldVk then
        pcall(keyrelease, gmHeldVk)
        gmHeldVk = nil
    end
end

-- is this exact gun the tool in hand right now? a dry ticked gun left in hand
-- must not count as "a ticked gun is out", or the last gun with ammo never
-- gets pulled while the empty one sits there
local function gmOnGun(g)
    local held = heldToolName()
    if not held then return false end
    local low = tostring(held):lower()
    if g then return g.test(low) end
    for _, x in ipairs(gmEnabled()) do
        if x.test(low) then return true end
    end
    return false
end

-- press the next ticked gun's hotbar key and hold it until the next swap
local function gmStepKeys()
    local ammoOn = cfg("gm_ammo") and true or false
    local slots = gmSlots(ammoOn and gmPool() or {}, ammoOn)
    local n = #slots
    if n == 0 then
        -- nothing has ammo: leave whatever is in hand alone. releasing the
        -- hotbar key does not unequip a tool
        gmRelease()
        gmPin, gmCheckAt = nil, 0
        return
    end
    if n == 1 then
        -- one gun left with ammo: pin to that gun. its slot is only pressed again
        -- once that exact gun has left the hand (respawn, manual switch, the game
        -- unequipping it), never while it is out, so it cannot be pulled out and
        -- straight back in on the same gun. the ammo filter still flickers this
        -- list 1 -> 0 -> 1 while the gun reloads, and a dry ticked gun sitting in
        -- hand does not count as this gun being out
        local s = slots[1]
        local vk = 0x30 + s.slot
        if s.slot ~= gmPin then
            gmPin, gmCheckAt = s.slot, 0
        end
        if gmHeldVk and gmHeldVk ~= vk then gmRelease() end
        gmHeldVk = vk
        local now = tick()
        -- mm2 sometimes swallows the first hotkey press after a switch, so retry a
        -- quarter second later instead of once a second. a press only happens while
        -- this gun is NOT in hand, so retrying cannot pump it in and out
        if now - gmCheckAt < 0.25 then return end
        gmCheckAt = now
        if gmOnGun(s.gun) then return end
        gmRelease()
        if pcall(keypress, vk) then gmHeldVk = vk end
        return
    end
    gmPin = nil
    gmIdx = (gmIdx % n) + 1
    local vk = 0x30 + slots[gmIdx].slot
    gmRelease()
    if pcall(keypress, vk) then gmHeldVk = vk end
end

-- direct equip, for games that let a script move the tool itself
local function gmStepEquip()
    local pool, hum = gmPool()
    if not hum or #pool == 0 then return end
    local held = heldToolName()
    local tool
    for _, t in ipairs(pool) do
        if t.Name ~= held then
            if not gmToolEmpty(t) then
                tool = t
                break
            end
        end
    end
    -- no other gun has ammo: stay on the gun in hand instead of equipping a
    -- known-empty one and pulling it back out on the next swap
    if not tool then return end
    pcall(function()
        if cfg("gm_drop") then hum:UnequipTools() end
        hum:EquipTool(tool)
    end)
end

local function gmStep()
    if not gmActive() then
        gmRelease()
        return
    end
    local now = tick()
    if now < gmNext then return end
    local delay = (tonumber(cfg("gm_delay")) or 60) / 1000
    gmNext = now + math.max(delay, 0.01)

    if cfg("gm_method") == "equip" then
        gmStepEquip()
    else
        gmStepKeys()
    end
end

local function gmStepSafe()
    local ok, err = pcall(gmStep)
    if not ok and err ~= gmErr then
        gmErr = err
        warn("gun macro error: " .. tostring(err))
    end
end

local gmHooked = false
pcall(function()
    local rs = game:GetService("RunService")
    if rs and rs.Heartbeat then
        rs.Heartbeat:Connect(gmStepSafe)
        gmHooked = true
    end
end)

if not gmHooked then
    spawn(function()
        while true do
            gmStepSafe()
            wait(0.01)
        end
    end)
end

local function safeStep()
    local ok, err = pcall(step)
    if not ok and err ~= lastErr then
        lastErr = err
        warn("triggerbot error: " .. tostring(err))
    end
end

local loopHooked = false
pcall(function()
    local rs = game:GetService("RunService")
    if rs and rs.Heartbeat then
        rs.Heartbeat:Connect(safeStep)
        loopHooked = true
    end
end)

if not loopHooked then -- fallback if Heartbeat isn't there
    spawn(function()
        while true do
            safeStep()
            wait(0.001)
        end
    end)
end

local CFG_DIR = "triggerbot"

local function cfgPath(name)
    return CFG_DIR .. "/" .. name .. ".cfg"
end

local function saveConfig(name)
    local lines = {}
    for k, val in pairs(CFG) do
        -- menu-only state (file slots, display names) stays out of the file
        if not k:match("^cfg") and not k:match("Name$") then
            lines[#lines + 1] = k .. "=" .. tostring(val)
        end
    end
    table.sort(lines)
    pcall(makefolder, CFG_DIR)
    return pcall(writefile, cfgPath(name), table.concat(lines, "\n"))
end

local function loadConfig(name)
    local ok, raw = pcall(readfile, cfgPath(name))
    if not ok or type(raw) ~= "string" then return false end
    for line in raw:gmatch("[^\r\n]+") do
        local k, val = line:match("^([%w_]+)=(.*)$")
        if k and CFG[k] ~= nil then
            local n = tonumber(val)
            if n then
                CFG[k] = n
            elseif val == "true" then
                CFG[k] = true
            elseif val == "false" then
                CFG[k] = false
            elseif k == "tb_kbmode" or k == "gm_mode" or k == "gm_method" then
                -- string settings: numbers and booleans cannot carry them
                CFG[k] = val
            end
        end
    end
    return true
end

-- ---------------------------------------------------------------
-- autoload: remember the last config used and restore it on start
-- ---------------------------------------------------------------
local AUTO_FILE = CFG_DIR .. "/autoload.txt"

local function setAutoName(name)
    pcall(makefolder, CFG_DIR)
    pcall(writefile, AUTO_FILE, tostring(name or ""))
end

local function getAutoName()
    local ok, raw = pcall(readfile, AUTO_FILE)
    if not ok or type(raw) ~= "string" then return nil end
    local n = raw:gsub("[^%w_%- ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #n == 0 then return nil end
    return n
end

if CFG.tb_autoload == nil then CFG.tb_autoload = true end

local function autoloadOnStart()
    if CFG.tb_autoload == false then return end
    local name = getAutoName()
    if not name then return end
    if loadConfig(name) then
        CFG.cfgName = name
    end
end

autoloadOnStart()

local function scanConfigs()
    local out = {}
    local ok, files = pcall(listfiles, CFG_DIR)
    if ok and type(files) == "table" then
        for _, f in ipairs(files) do
            local n = tostring(f):match("([^/\\]+)%.cfg$")
            if n then out[#out + 1] = n end
        end
    end
    table.sort(out)
    return out
end

