-- One queue entry per BODY, not per fire. A body can only pay once, and one entry
-- per fire let stale entries soak up the credits meant for the next body - that
-- body then looks unpaid forever and gets ground until it respawns.
local function armCredit(t, now)
    for _, q in ipairs(pendingQ) do
        if q.id == t.id and q.char == t.char then return end
    end
    pendingQ[#pendingQ + 1] = { ref = t, id = t.id, char = t.char, at = now }
end
