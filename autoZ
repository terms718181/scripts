        local gun, ammo = equippedGun()
        return S.on, status, target and target.plr.Name or "-", shots,
            gun and gun.Name or "-", ammo and ammo.Value or -1,                S.gun, tabError, toggleKey, loopError,
                stompFires, creditedStomps() - stompBase, stompMiss, settleTime, cooldown, stompLanded
    end,
    stop = function()
        running = false
        if mainConn then mainConn:Disconnect() mainConn = nil end
        if aimConn then aimConn:Disconnect() aimConn = nil end
        if keyConn then keyConn:Disconnect() keyConn = nil end
        if label then label:Remove() label = nil end
        pcall(UI.RemoveTab, "Auto Farm")
        _G.AutoFarm = nil
    end,
}

print("Auto Farm loaded - K toggles, auto stomp on, _G.AutoFarm.stop() stops")
