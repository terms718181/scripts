-- ------------------------------------------------------------------- target logic
local function pickTarget()
    local ch = lp.Character
    local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local myPos = myRoot.Position
    -- Rank decides who is worth walking to, distance only breaks ties:
    --   3 = a downed body that has not paid yet (a stomp that still credits)
    --   2 = a live player (go knock them down)
    -- A body that already paid is not a target at all, not even as a last resort.
    -- Camping a spent corpse is exactly what looked like the farm stalling until
    -- that player respawned, when there was simply nothing left to do. With no
    -- candidate the loop keeps scanning and takes a respawn the moment it lands.
    local best, bestD, bestRank = nil, S.range, 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local tc = p.Character
            local root = tc and tc:FindFirstChild("HumanoidRootPart")
            local hum = tc and tc:FindFirstChild("Humanoid")
            if root and hum then
                local be = tc:FindFirstChild("BodyEffects")
                local ko = be and be:FindFirstChild("K.O")
                local dead = be and be:FindFirstChild("Dead")
                -- Downed and dead both count: a body lying there still pays, and
                -- that is the state most targets end up in mid-fight.
                local downed = (ko and ko.Value == true) or (dead and dead.Value == true)
                local spent = downed and (paidFor[p.UserId] == tc)
                if not spent then
                    -- A body always outranks a live player: the farm stays on it
                    -- until the stomp is actually credited, then the watcher drops
                    -- the target and the next scan takes whoever is alive.
                    local rank = downed and 3 or 2
                    local d = (root.Position - myPos).Magnitude
                    if d <= S.range and (rank > bestRank or (rank == bestRank and d < bestD)) then
                        bestRank, bestD = rank, d
                        best = {
                            plr = p, id = p.UserId, char = tc, root = root, hum = hum,
                            head = tc:FindFirstChild("Head") or root,
                            ko = ko, dead = dead, rank = rank,
                        }
                    end
                end
            end
        end
    end
    return best
end

local function isGone(t)
    if not t then return true end
    if not t.char or not t.char.Parent then return true end
    -- Health 0 and Dead are NOT "gone": the body stays stompable until the
    -- player respawns, which replaces the character and trips the check above.
    return false
end

local function isKnocked(t)
    return t and t.ko and t.ko.Value == true
end

-- Stompable = downed OR dead. Dead bodies are not skipped: a player who fell out
-- of K.O. into Dead still lies there and is still stompable, and dropping them is
-- what made the farm go quiet the moment a target finished dying.
local function isStompable(t)
    if not t then return false end
    if t.ko and t.ko.Value == true then return true end
    if t.dead and t.dead.Value == true then return true end
    return false
end

-- The same ranks pickTarget uses, recomputed for the body we are already on, so
-- a better target appearing mid-fight pulls the farm off a spent body. 0 means
-- "not worth being on at all" - a corpse that has already paid.
local function targetRank(t)
    if not t then return 0 end
    if isStompable(t) then
        if paidFor[t.id] == t.char then return 0 end
        return 3
    end
    return 2
end

task.spawn(function()
