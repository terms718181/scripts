-- ------------------------------------------------------------------- main loop
local mainConn
mainConn = RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if not S.on then
        status = "off"
        return
    end
    local step = math.min(dt or (1 / 60), 0.05)
    local okRun, err = pcall(function()
        local now = tick()
        local ch = lp.Character
        local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChild("Humanoid")
        if not myRoot or not hum or hum.Health <= 0 then
            status = "waiting for respawn"
            return
        end

        local t = target
        if not t or isGone(t) then
            -- Say why there is nothing to do, so an empty server never reads as a
            -- hung script. If every other player is a stomped body there is no
            -- one to go to - the scan is still running and takes the first
            -- respawn, so this is a wait on the players, not on a corpse.
            local down, total = 0, 0
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp then
                    local pc = p.Character
                    if pc then
                        total = total + 1
                        local be = pc:FindFirstChild("BodyEffects")
                        local ko = be and be:FindFirstChild("K.O")
                        local dead = be and be:FindFirstChild("Dead")
                        if (ko and ko.Value == true) or (dead and dead.Value == true) then
                            down = down + 1
                        end
                    end
                end
            end
            status = "waiting for a live player (" .. down .. "/" .. total .. " down)"
            return
        end

        if S.tp then
            local tp = t.root.Position
            local goal = Vector3.new(tp.X, tp.Y + S.hover, tp.Z)
            local cur = myRoot.Position
            local delta = goal - cur
            local dist = delta.Magnitude

            if dist > 60 then
                -- Long approach: one snap, then the glide takes over.
                if now - lastTele >= 0.05 then
                    lastTele = now
                    local flat = Vector3.new(tp.X - goal.X, 0, tp.Z - goal.Z)
                    if flat.Magnitude < 0.5 then flat = Vector3.new(1, 0, 0) end
                    myRoot.CFrame = CFrame.lookAt(goal, goal + flat)
                    myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            else
                -- Glide. AssemblyLinearVelocity is useless here (measured: the
                -- Humanoid's mover overwrites it, 0.7 studs of travel in 0.8s),
                -- so the position is written directly - but only a fraction of
                -- the remaining gap per frame, with our own facing preserved.
                -- That removes the 8-stud snap that made hovering look glitchy.
                local alpha = 1 - math.exp(-S.stickK * step)
                local maxStep = math.min(S.stickK * step * 14, STICK_MAX * step)
                if maxStep < 0.4 then maxStep = 0.4 end
                local move = delta * alpha
                if move.Magnitude > maxStep then move = move.Unit * maxStep end
                local nextPos = cur + move
                local look = myRoot.CFrame * Vector3.new(0, 0, -1)
                local flat = look - myRoot.Position
                if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
                myRoot.CFrame = CFrame.lookAt(nextPos, nextPos + flat)
                myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end

        if isStompable(t) then
            if not S.stomp then
                status = "knocked " .. t.plr.Name
                return
            end
            if not stompRemote then
                loopError = "no MainRemoteEvent"
                return
            end

            -- Instant stomp: fire the remote as soon as the rate allows. The
            -- landed counter is measured after the fact and gates nothing.
            if now - lastStomp >= S.stompRate then
                lastStomp = now
                stompFires = stompFires + 1
                local be = ch:FindFirstChild("BodyEffects")
                local ign = workspace:FindFirstChild("Ignored")
                pcall(function()
                    stompRemote:FireServer("Stomp", { Ignored = ign and { ign } or {} }, nil, be)
                end)
                -- Arms the credit watcher; it does the switching the moment this
                -- fire is actually paid for, so nothing is paced here.
                armCredit(t, now)
                status = "stomping " .. t.plr.Name
            end
            return
        end

        local gun, ammo = equippedGun()
        local count = ammo and ammo.Value or nil

        if S.gun ~= "Auto" and (not gun or gun.Name ~= S.gun) then
            status = "equip " .. S.gun .. " yourself"
            return
        end
        if count and count <= 0 then
            status = "out of ammo (press R)"
            return
        end
        if now - lastFire >= S.fire then
            lastFire = now
            pcall(mouse1click)
            shots = shots + 1
        end
        status = "shooting " .. t.plr.Name ..
            (gun and ("  [" .. (count or "?") .. " " .. gun.Name .. "]") or "  [fists]")
    end)
    if not okRun then loopError = "main: " .. tostring(err) end
end)

