end)

task.spawn(function()
    while running do
        local ok, err = pcall(function()
            if target and isGone(target) then
                target = nil
            end
            -- Scan on every pass, never just once. Whatever is alive (or freshly
            -- knocked) is taken the moment it shows up, so a respawn pulls the
            -- farm off a spent corpse instead of leaving it to wait there.
            local cand = pickTarget()
            if cand then
                if not target or targetRank(cand) > targetRank(target) then
                    if target and cand ~= target then
                        status = "switch " .. cand.plr.Name
                    end
                    target = cand
                end
            elseif target and targetRank(target) == 0 then
                -- Spent corpse: let it go instead of sitting on it until it
                -- respawns. The scan keeps running, so the respawn is still taken.
                target = nil
            end
        end)
        if not ok then loopError = "target: " .. tostring(err) end
        task.wait(0.05)                        -- 20 scans a second: a respawn is taken at once
    end
end)

-- --------------------------------------------------------------- credit watcher
-- A stomp pays out through ProfileStats.Stomps, not through the remote's return
-- value (that returns true on every call). Poll it fast: the instant the count
-- ticks up, the body that was just stomped is spent, so mark it paid and drop
-- the target - the next pass then goes straight to somebody else.
task.spawn(function()
    while running do
        local c = creditedStomps()
        if creditedSeen == nil then creditedSeen = c end
        -- One credit per fire, oldest first. A single slot lost credits whenever
        -- two landed close together, and a body that was paid but never marked
        -- reads as unpaid forever - the farm then sits on that corpse stomping
        -- something that can never pay again. Matching a queue keeps every fire
        -- accounted for, so a paid body is always recognised and dropped.
        while c > creditedSeen and #pendingQ > 0 do
            local p = table.remove(pendingQ, 1)
            creditedSeen = creditedSeen + 1
            stompLanded = stompLanded + 1
            if p.char then paidFor[p.id] = p.char end
            if target == p.ref then
                target = nil
                status = "next"
            end
        end
        if c > creditedSeen then creditedSeen = c end     -- a credit we cannot place
        task.wait(0.05)
    end
end)

-- Mirrors the panel toggle and keeps the rebindable key in sync.
task.spawn(function()
    while running do
        -- The tab builder only runs while the tab is on screen; closing the menu
        -- resets the widget store and that reset looks exactly like an unticked
        -- box. Track panel health so a reset is never read as a click.
        local readyNow = tabReady and (tick() - tabReadyAt) <= 1.5
        if readyNow ~= wasReady then
            wasReady = readyNow
            lastSeenToggle = enabled
            ignoreToggleUntil = tick() + 0.8
            if not readyNow then pcall(UI.SetValue, "af_on", enabled) end
        end

        local v = ui("af_on", nil)
        if v ~= nil then
            if tick() < ignoreToggleUntil then
                lastSeenToggle = v          -- swallow the write we just made
                -- and make the box show the truth again if the store drifted
                if v ~= enabled then pcall(UI.SetValue, "af_on", enabled) end
            elseif not readyNow then
                -- Panel is not drawing right now: whatever the store holds is a
                -- reset artefact, not a click. Keep the script state and push it
                -- back so the toggle shows the truth when the panel returns.
                lastSeenToggle = enabled
                if v ~= enabled and tick() - lastPushBack > 0.5 then
                    lastPushBack = tick()
                    pcall(UI.SetValue, "af_on", enabled)
                end
            elseif lastSeenToggle == nil then
                lastSeenToggle = v
                if v ~= enabled then setEnabled(v, true) end
            elseif v ~= lastSeenToggle then
                setEnabled(v, true)
            end
        end
        if kbWidget then
            local ok, k = pcall(function() return kbWidget:GetKey() end)
            if ok and k ~= nil then
                local vk = (type(k) == "number") and k or nil
                if not vk then
                    local okv, kv = pcall(function() return k.Value end)
                    if okv and type(kv) == "number" then vk = kv end
                end
                if vk and vk > 0 then toggleKey = vk end
            end
        end

        -- Second path: poll the key directly in case a press never reaches
        -- InputBegan. The first sample only calibrates the latch. Both paths
        -- share lastTogglePress, so one press can never toggle twice.
        local down = keyDown(toggleKey)
        if downLatch == nil then
            downLatch = down
        elseif down and not downLatch and tick() - lastTogglePress >= 0.35 then
            lastTogglePress = tick()
            setEnabled(not enabled, false)
        end
        downLatch = down
        task.wait(0.1)
    end
end)

-- The toggle key itself. Your physical keyboard is not limited: only synthetic
-- presses are, so this listener always fires.
local keyConn
keyConn = UIS.InputBegan:Connect(function(input)
    if not running then return end
    local k = input and input.KeyCode
    if k == nil then return end
    local num = (type(k) == "number") and k or nil
    if not num then
        local ok, kv = pcall(function() return k.Value end)
        if ok and type(kv) == "number" then num = kv end
    end
    if not keyMatches(num, toggleKey) then return end
    if tick() - lastTogglePress < 0.35 then return end
    lastTogglePress = tick()
    setEnabled(not enabled, false)
end)

