-- Real keys arrive as Roblox KeyCodes (K = 107), the menu keybind speaks VK
-- codes (K = 75), and IsKeyDown only takes the Roblox number. Bridge all three.
local function keyMatches(num, target)
    if not num or not target then return false end
    if num == target then return true end
    if target >= 65 and target <= 90 and num == target + 32 then return true end
    if target >= 97 and target <= 122 and num == target - 32 then return true end
    return false
end

local function keyDown(target)
    local function one(c)
        local ok, d = pcall(function() return UIS:IsKeyDown(c) end)
        return ok and d == true
    end
    if one(target) then return true end
    if target >= 65 and target <= 90 and one(target + 32) then return true end
    if target >= 97 and target <= 122 and one(target - 32) then return true end
    return false
end

