label.Size = 14
label.Outline = true
label.Center = true
label.Position = Vector2.new(960, 26)
label.Color = Color3.fromRGB(120, 255, 150)

local lastBeat = 0
task.spawn(function()
    while running do
        local t = target
        local dist = "?"
        if t then
            local ch = lp.Character
            local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
            if myRoot then
                dist = tostring(math.floor((t.root.Position - myRoot.Position).Magnitude + 0.5))
            end
        end
        local keyName = "K"
        if kbWidget then
            local ok, n = pcall(function() return kbWidget:GetKeyName() end)
            if ok and type(n) == "string" and n ~= "" then keyName = n end
        end
        local extra = tabError and ("  |  UI: " .. tabError)
            or (loopError and ("  |  err: " .. loopError) or "")
        local credited = creditedStomps() - stompBase
        label.Text = "AutoFarm [" .. keyName .. "]: " .. status ..
            "  |  shots " .. shots ..
            (S.stomp and ("  |  stomp " .. stompLanded .. "/" .. stompFires ..
                "  (+" .. credited .. ")") or "") ..
            (t and ("  |  " .. dist .. " studs") or "") .. extra
        label.Visible = S.overlay

        -- Liveness trace: an executor re-init can kill this script without any
        -- error anywhere, so leave a timestamp on disk for post-mortems.
        if tick() - lastBeat > 5 then
            lastBeat = tick()
            pcall(writefile, "af_state.txt", table.concat({
                "tick=" .. string.format("%.1f", tick()),
                "on=" .. tostring(enabled),
                "tabReady=" .. tostring(tabReady),
                "state=" .. status,
                "shots=" .. shots,
                "stomps=" .. stompFires,
                "target=" .. (target and target.plr.Name or "-"),
            }, " "))
        end

        task.wait(0.2)
    end
end)

-- ------------------------------------------------------------------- menu tab
-- Matcha can reset its widget store (menu re-init) and can start rejecting a
-- single widget. Each call below is isolated so one bad widget cannot stop the
-- section from drawing, and tabReady tells the mirror loop whether the panel is
-- currently trustworthy.
local lastBuiltSig = nil
local comboBadSig = nil

local function buildTab()
    UI.AddTab("Auto Farm", function(tab)
        local firstError = nil
        local function attempt(label, fn)
            local ok, res = pcall(fn)
            if ok then return res end
            if not firstError then
                firstError = label .. ": " .. tostring(res)
                print("AutoFarm tab: " .. firstError)
            end
            return nil
        end

        local farm = attempt("section", function() return tab:Section("Farm", "Left") end)
        if not farm then
            tabReady, tabError = false, firstError
            return
        end

        attempt("toggle", function() farm:Toggle("af_on", "Auto Farm", enabled) end)

        local kb = attempt("keybind", function() return farm:Keybind("af_kb", 0x4B, "toggle") end)
        if kb then
            kbWidget = kb
            if kb.AddToHotkey then
                attempt("hotkey", function() kb:AddToHotkey("Auto Farm", "af_on") end)
            end
        end

        local gotSig = gunSig
        local rebuild = (gotSig ~= lastBuiltSig) and (gotSig ~= comboBadSig)
        local combo = attempt("combo", function()
            local c = farm:Combo("af_gun", "Weapon", gunList, DEFAULT.gun)
            if rebuild then
                c:Clear()
                for _, name in ipairs(gunList) do c:Add(name) end
            end
            return c
        end)
        if combo then
            lastBuiltSig = gotSig
        elseif rebuild then
            comboBadSig = gotSig            -- stop retrying a list the UI rejects
        end

        attempt("tip", function() farm:Tip("Auto = whatever gun is in your hand") end)

        attempt("stomp", function() farm:Toggle("af_stomp", "Auto Stomp (remote)", S.stomp) end)
        attempt("stomprate", function() farm:SliderInt("af_stomp_rate", "Stomp Rate (ms)", 60, 1000, DEFAULT.stomp) end)
        attempt("stick", function() farm:SliderInt("af_stick", "Stick Strength", 4, 40, DEFAULT.stick) end)

        attempt("hover", function() farm:SliderInt("af_hover", "Stand Height", 1, 10, DEFAULT.hover) end)
        attempt("fire", function() farm:SliderInt("af_fire", "Fire Rate (ms)", 50, 500, DEFAULT.fire) end)
        attempt("range", function() farm:SliderInt("af_range", "Max Distance", 50, 20000, DEFAULT.range) end)

        tabReady = true
        tabReadyAt = tick()
        tabError = firstError
    end)
end
buildTab()

_G.AutoFarm = {
    cfg = S,
    set = function(v) setEnabled(v, false) end,
    stomp = function(v)
        S.stomp = v and true or false
        pcall(UI.SetValue, "af_stomp", S.stomp)
    end,
    status = function()
        local gun, ammo = equippedGun()
        return S.on, status, target and target.plr.Name or "-", shots,
            gun and gun.Name or "-", ammo and ammo.Value or -1,                S.gun, tabError, toggleKey, loopError,
                stompFires, creditedStomps() - stompBase, stompMiss, settleTime, cooldown, stompLanded
    end,
    stop = function()
        running = false
        if mainConn then mainConn:Disconnect() mainConn = nil end
        if aimConn then aimConn:Disconnect() aimConn = nil end
        if keyConn then keyConn:Disconnect() keyConn = nil end
        if label then label:Remove() label = nil end
        pcall(UI.RemoveTab, "Auto Farm")
        _G.AutoFarm = nil
    end,
}

print("Auto Farm loaded - K toggles, auto stomp on, _G.AutoFarm.stop() stops")
